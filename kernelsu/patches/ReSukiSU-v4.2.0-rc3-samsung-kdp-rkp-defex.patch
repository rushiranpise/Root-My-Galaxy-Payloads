 kernelsu-objs += infra/file_wrapper.o
@@ -49,6 +51,22 @@ ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
 ccflags-y += -I$(srctree)/$(src) -I$(srctree)/$(src)/include
 ccflags-y += -I$(src) -I$(src)/include
 
+# Samsung compatibility. CI passes these as make variables (CONFIG_KSU_SAMSUNG_*=y, alongside
+# CONFIG_KSU=m), so the module's own options never have to exist in the DDK image's config for the
+# code that reads them to be compiled in.
+ifeq ($(CONFIG_KSU_SAMSUNG_KDP),y)
+ccflags-y += -DCONFIG_KSU_SAMSUNG_KDP=1
+endif
+ifeq ($(CONFIG_KSU_SAMSUNG_RKP),y)
+ccflags-y += -DCONFIG_KSU_SAMSUNG_RKP=1
+endif
+ifeq ($(CONFIG_KSU_SAMSUNG_DEFEX),y)
+ccflags-y += -DCONFIG_KSU_SAMSUNG_DEFEX=1
+endif
+ifeq ($(CONFIG_KSU_SAMSUNG_NO_PATCH_TEXT),y)
+ccflags-y += -DCONFIG_KSU_SAMSUNG_NO_PATCH_TEXT=1
+endif
+
 obj-$(CONFIG_KSU) += kernelsu.o
 
 REPO_NAME := ReSukiSU
diff --git a/kernel/Kconfig b/kernel/Kconfig
index 0174d2de..108e21c7 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -157,6 +157,45 @@ config KSU_MANUAL_HOOK_AUTO_INPUT_HOOK
 
 endmenu
 
+# What a stock Galaxy kernel needs that an AOSP one does not. All four are off by default: a device
+# that does not need them should not carry the code, and turning one on is a claim about the target
+# that a build cannot check for itself.
+config KSU_SAMSUNG_KDP
+    bool "Samsung KDP credential handling"
+    depends on KSU
+    default n
+    help
+      Install credentials through Samsung's KDP task bookkeeping instead of commit_creds()
+      directly, and release them the same way. Without this, a task's credentials and the
+      vendor's record of them disagree, which shows up as a root process that cannot be
+      signalled or reaped as expected.
+
+config KSU_SAMSUNG_RKP
+    bool "Samsung RKP sucompat bypass"
+    depends on KSU && KRETPROBES
+    default n
+    help
+      Reach setresuid and the su-compatibility syscalls through kretprobes on their own entry
+      points, for a target whose syscall table cannot be patched at all (the dispatcher stays
+      unavailable and the sys_enter tracepoint is never armed).
+
+config KSU_SAMSUNG_DEFEX
+    bool "Samsung DEFEX bypass"
+    depends on KSU
+    default n
+    help
+      Let tasks this module has elevated through Samsung's DEFEX enforcement, and re-sync a task
+      with it after the credential swap.
+
+config KSU_SAMSUNG_NO_PATCH_TEXT
+    bool "Disable text patching (Exynos EL2)"
+    depends on KSU
+    default n
+    help
+      Refuse every text patch instead of attempting one that the platform will fault. Set this on
+      a target where the hypervisor protects kernel text, so callers fail with an error rather
+      than half-succeeding.
+
 menu "KernelSU - SUSFS"
     depends on KSU_SUSFS
 
diff --git a/kernel/compat/samsung_defex.c b/kernel/compat/samsung_defex.c
new file mode 100644
index 00000000..a73ac302
--- /dev/null
+++ b/kernel/compat/samsung_defex.c
@@ -0,0 +1,124 @@
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/kprobes.h>
+#include <linux/moduleparam.h>
+#include <linux/sched.h>
+
+#include "compat/samsung_defex.h"
+#include "infra/symbol_resolver.h"
+#include "klog.h"
+#include "selinux/selinux.h"
+
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+typedef void (*defex_get_task_creds_t)(struct task_struct *task, unsigned int *uid, unsigned int *fsuid,
+                                       unsigned int *egid, unsigned short *cred_flags);
+typedef int (*defex_set_task_creds_t)(struct task_struct *task, unsigned int uid, unsigned int fsuid, unsigned int egid,
+                                      unsigned short cred_flags);
+
+static defex_get_task_creds_t defex_get_task_creds;
+static defex_set_task_creds_t defex_set_task_creds;
+static bool defex_enforce_hooked;
+
+/*
+ * The bypass is for KernelSU's own root tasks - the ones carrying the KernelSU
+ * domain. A task can be genuinely uid 0 without that domain: adbd raised to root
+ * by the adb_root feature, or a manager whose root domain this kernel was not
+ * built against. That class gets the bypass here too, which is what a working
+ * Samsung temp root ships, and it stays a switch rather than the condition:
+ *
+ *     echo 0 > /sys/module/kernelsu/parameters/samsung_defex_broad_root
+ *
+ * turns it back into upstream's rule: uid 0 *and* the KernelSU domain.
+ */
+static bool samsung_defex_broad_root = true;
+module_param(samsung_defex_broad_root, bool, 0644);
+MODULE_PARM_DESC(samsung_defex_broad_root, "Bypass Samsung DEFEX for uid-0 tasks outside the KernelSU domain");
+
+static int ksu_samsung_defex_pre_handler(struct kprobe *probe, struct pt_regs *regs)
+{
+    struct task_struct *task = (struct task_struct *)regs->regs[0];
+
+    (void)probe;
+    if (task != current || current_uid().val != 0)
+        return 0;
+
+    if (is_ksu_domain()) {
+        regs->regs[0] = 0;
+    } else if (samsung_defex_broad_root) {
+        /* Says when the switch is doing something, so "the bypass is on" is a
+         * measurement instead of an assumption. */
+        regs->regs[0] = 0;
+        pr_info_ratelimited("Samsung DEFEX bypass: uid-0 task outside the KernelSU domain (pid %d, %s)\n",
+                            task_pid_nr(current), current->comm);
+    }
+
+    return 0;
+}
+
+static struct kprobe defex_enforce_kprobe = {
+    .symbol_name = "task_defex_enforce",
+    .pre_handler = ksu_samsung_defex_pre_handler,
+};
+#endif
+
+int ksu_samsung_defex_init(void)
+{
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+    int ret;
+
+    defex_get_task_creds = (defex_get_task_creds_t)ksu_resolve_symbol_for_functable_hook("get_task_creds");
+    defex_set_task_creds = (defex_set_task_creds_t)ksu_resolve_symbol_for_functable_hook("set_task_creds");
+    if (!defex_get_task_creds || !defex_set_task_creds) {
+        pr_err("Samsung DEFEX credential functions unavailable\n");
+        return -ENOENT;
+    }
+
+    ret = register_kprobe(&defex_enforce_kprobe);
+    if (ret) {
+        pr_err("Samsung DEFEX enforce hook unavailable: %d\n", ret);
+        return ret;
+    }
+    defex_enforce_hooked = true;
+
+    pr_info("Samsung DEFEX credential synchronization and KSU-task bypass enabled\n");
+#endif
+    return 0;
+}
+
+void ksu_samsung_defex_exit(void)
+{
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+    if (defex_enforce_hooked) {
+        unregister_kprobe(&defex_enforce_kprobe);
+        defex_enforce_hooked = false;
+    }
+#endif
+}
+
+void ksu_samsung_defex_sync_current(void)
+{
+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+    const struct cred *cred = current_cred();
+    unsigned int stored_uid;
+    unsigned int stored_fsuid;
+    unsigned int stored_egid;
+    unsigned short cred_flags;
+    int ret;
+
+    defex_get_task_creds(current, &stored_uid, &stored_fsuid, &stored_egid, &cred_flags);
+
+    if (__kuid_val(cred->euid) == 0 && __kuid_val(cred->fsuid) == 0 && __kgid_val(cred->egid) == 0) {
+        stored_uid = 1;
+        stored_fsuid = 1;
+        stored_egid = 1;
+    } else {
+        stored_uid = __kuid_val(cred->euid);
+        stored_fsuid = __kuid_val(cred->fsuid);
+        stored_egid = __kgid_val(cred->egid);
+    }
+
+    ret = defex_set_task_creds(current, stored_uid, stored_fsuid, stored_egid, cred_flags);
+    if (ret)
+        pr_err("Samsung DEFEX credential synchronization failed: %d\n", ret);
+#endif
+}
